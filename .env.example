# Supabase 项目配置
# 复制此文件为 .env.local，填入真实值，然后重启开发服务器：pnpm dev
# （.env.local 已被 .gitignore 忽略，不会提交）

SUPABASE_URL=https://your-project.supabase.co

# 公开密钥（新旧两种写法任选其一）
# SUPABASE_ANON_KEY=eyJ...            # 旧版 anon public key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 服务端专用密钥：自建 users/sessions 表读写必需（RLS 只允许 secret 访问）
# 新版用 sb_secret_...，旧版用 service_role 的 JWT
# ⚠️ 切勿提交到仓库、切勿发送到浏览器
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...
