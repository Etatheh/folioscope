# =============================================================================
# GUI Markets · 环境变量
# =============================================================================

# ---------------------------------------------------------------------------
# 数据库（Supabase Postgres）
# 不配置则自动回退到本地 SQLite（仅开发环境）
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...    (新版，推荐)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_... (旧版，二者选一)
# SUPABASE_ANON_KEY=...                (新版：SUPABASE_PUBLISHABLE_KEY，可选)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# 浏览器端登录（Supabase Auth / OAuth）
# 前端通过 /api/auth/config 读取上面的 SUPABASE_URL + PUBLISHABLE_KEY，
# 无需再重复配置 NEXT_PUBLIC_*。若使用独立项目，也可显式设置：
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
#
# Google 登录：在 Supabase Dashboard → Authentication → Providers → Google
# 开启，并把线上域名 / http://localhost:3000 加入 Redirect URLs。
# Microsoft 为预留的 azure provider，接入后把
# components/auth/AuthModal.tsx 里的 MICROSOFT_OAUTH_ENABLED 改为 true。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI 助手（DeepSeek 或兼容 API）
# 不配置则用内置分析器（不需要联网 AI）
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 开发者超级权限（完整解锁 dashboard，AI 助手不限每日额度）
# 仅填写开发者本人的登录邮箱；服务端校验，不要暴露到 NEXT_PUBLIC_* 变量。
# 多个邮箱用英文逗号分隔。修改后需重启服务；线上也要配置同名变量。
# ---------------------------------------------------------------------------
# ADMIN_EMAILS=dev@example.com,owner@example.com

# ---------------------------------------------------------------------------
# 支付（Lemon Squeezy）
# 不配置时显示 demo 升级按钮
# ---------------------------------------------------------------------------
# LEMON_SQUEEZY_CHECKOUT_URL=https://...
# LEMON_SQUEEZY_STORE_ID=xxx
# LEMON_SQUEEZY_PRO_VARIANT_ID=xxx
# LEMON_SQUEEZY_WEBHOOK_SECRET=xxx