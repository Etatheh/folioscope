# Supabase 项目配置
# 复制此文件为 .env.local，填入真实值，然后重启开发服务器：pnpm dev
# （.env.local 已被 .gitignore 忽略，不会提交）

SUPABASE_URL=https://your-project.supabase.co

# 公开密钥（新旧两种写法任选其一）
# SUPABASE_ANON_KEY=eyJ...            # 旧版 anon public key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 服务端专用密钥：自建 users/sessions 表读写必需（RLS 只允许 secret 访问）
# 新版用 sb_secret_...，旧版用 service_role 的 JWT
# ⚠️ 切勿提交到仓库、切勿发送到浏览器
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Lemon Squeezy 支付（Pro 订阅）
# 配置后「升级 Pro」会跳转到真实结算页；未配置时按钮走演示升级，界面功能不受影响。
# 两种写法二选一：
# 1) 直接给一个 checkout 链接
# LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/000000
# 2) 给 store 子域名 + Pro 变体 id，服务端自动拼链接
# LEMON_SQUEEZY_STORE_ID=your-store
# LEMON_SQUEEZY_PRO_VARIANT_ID=000000
#
# Webhook：Lemon Squeezy 后台 Settings → Webhooks
#   URL: https://<你的域名>/api/billing/webhook
#   事件: order_created, subscription_created, subscription_resumed,
#         subscription_payment_success, subscription_expired
# 签名密钥（签名算法 HMAC-SHA256，请求头 X-Signature）
# LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_your_signing_secret
